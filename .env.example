# Copy to .env (gitignored) and edit. Then: node refresh.js
# Bot tokens do not belong here. They stay in bots.csv, and refresh.js
# writes each one to $OMB_DATA_DIR/telegram-bots/<instance>.env (mode 600).

# Account that runs the systemd service. Defaults to the user running refresh.js.
OMB_SERVICE_USER=
OMB_SERVICE_HOME=

# Checkout of this repository, and the node binary that should run it.
OMB_GATEWAY_DIR=
OMB_NODE_BIN=
# PATH for the service. Leave empty to use the PATH of the refresh.js process.
OMB_PATH=

# OpenMaus data directory and loopback API. Defaults: ~/.openmausbot and :8799.
OMB_DATA_DIR=
OMB_SERVER_URL=http://127.0.0.1:8799

# Optional public image bed. Leave the directory and base empty to skip it.
# Gateway then sends local photos with sendPhoto instead of embedding a URL.
OMB_IMAGE_PUBLISH_DIR=
OMB_IMAGE_PUBLIC_BASE=
OMB_IMAGE_HOST=
OMB_IMAGE_PREFIX=/omb-img
OMB_IMAGE_CONTAINER=omb-img
OMB_IMAGE_NETWORK=edge
# Where refresh.js writes the rendered compose and Traefik files. Empty skips that write.
OMB_IMAGE_COMPOSE_DEST=
OMB_IMAGE_TRAEFIK_DEST=

# Optional. Colon-separated absolute directories the gateway may send back.
# Default is the data directory plus the service home.
# OMB_FILE_ROOTS=
